+/* === Breeze: peer-hash QP routing + NIC flag fence === */
+/* Cached env lookup for NVSHMEM_IB_PEERHASH. Default: enabled.
+ * Set NVSHMEM_IB_PEERHASH=0 to fall back to stock round-robin routing
+ * and proxy-drain fence. */
+static int nvshmemt_ib_peer_hash_enabled(void) {
+    static int cached = -1;
+    if (cached < 0) {
+        const char *env = getenv("NVSHMEM_IB_PEERHASH");
+        cached = (env && env[0] == '0') ? 0 : 1;
+        fprintf(stderr, "[breeze] NVSHMEM_IB_PEERHASH=%s (peer-hash routing %s)\n",
+                env ? env : "(unset, default 1)",
+                cached ? "enabled" : "disabled");
+    }
+    return cached;
+}
